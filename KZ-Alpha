  this.download(new Blob([JSON.stringify({ v: 1, clips: clips })], { type: \"application/json\" }), \"kazakh-audio-pack.json\");\n  }\n\n  async importPack(e) {\n    const f = e.target.files && e.target.files[0];\n    e.target.value = \"\";\n    if (!f) return;\n    try {\n      const data = JSON.parse(await f.text());\n      const clips = (data && data.clips) || {};\n      const keys = Object.keys(clips);\n      for (let i = 0; i < keys.length; i++) {\n        const blob = await (await fetch(clips[keys[i]])).blob();\n        this.clips[keys[i]] = blob;\n        await this.write(st => st.put(blob, keys[i]));\n      }\n      this.setState({ packMsg: \"ok\" });\n    } catch (err) { this.setState({ packMsg: \"err\" }); }\n  }\n\n  async bake() {\n    this.setState({ packMsg: \"baking\" });\n    try {\n      const res = await fetch(location.href, { cache: \"no-store\" });\n      if (!res.ok) throw new Error(\"http\");\n      let html = await res.text();\n      const clips = await this.collectPack();\n      const tag = \"<script>window.__KZ_AUDIO_PACK=\" + JSON.stringify(clips).replace(/<\u002Fg, \"\\\\u003c\") + \";<\\/script>\";\n      html = html.indexOf(\"<\u002Fbody>\") >= 0 ? html.replace(\"<\u002Fbody>\", tag + \"<\u002Fbody>\") : html + tag;\n      this.download(new Blob([html], { type: \"text/html\" }), \"kazakh-alphabet-with-audio.html\");\n      this.setState({ packMsg: \"baked\" });\n    } catch (e) { this.setState({ packMsg: \"bakeErr\" }); }\n  }\n\n  setAudioSrc(mode) {\n    if (this.audioSrc === mode) return;\n    this.audioSrc = mode;\n    this.forceUpdate();\n  }\n\n  letterAudioText(row) {\n    const lower = row[0].slice(1);\n    if (row[1] === \"—\") return row[6][0][0];\n    return lower;\n  }\n\n  step(d) {\n    const list = this.filtered();\n    const cur = this.state.selIdx;\n    const pos = list.findIndex(i => i === cur);\n    const nxt = list[(pos + d + list.length) % list.length];\n    this.setState({ selIdx: nxt });\n  }\n\n  filtered() {\n    const f = this.state.filter;\n    const out = [];\n    DATA.forEach((row, i) => {\n      const cat = row[2];\n      if (f === \"all\"\n        || (f === \"v\" && cat === \"v\")\n        || (f === \"c\" && cat === \"c\")\n        || (f === \"k\" && row[3] === 1)\n        || (f === \"r\" && cat === \"r\")) out.push(i);\n    });\n    return out;\n  }\n\n  toggleLearned(i) {\n    const s = this.state.learned.slice();\n    const at = s.indexOf(i);\n    if (at >= 0) s.splice(at, 1); else s.push(i);\n    this.setState({ learned: s }, () => this.save());\n  }\n\n  /* ---- trace pad ---- */\n  ctx() {\n    const c = this.canvasRef.current;\n    return c ? c.getContext(\"2d\") : null;\n  }\n  pt(e) {\n    const c = this.canvasRef.current, r = c.getBoundingClientRect();\n    return { x: (e.clientX - r.left) * (c.width / r.width), y: (e.clientY - r.top) * (c.height / r.height) };\n  }\n  clearTrace() {\n    const ctx = this.ctx();\n    if (ctx) ctx.clearRect(0, 0, 800, 440);\n    this.drawing = false; this.lastPt = null;\n  }\n\n  /* ---- quiz ---- */\n  startQuiz() {\n    const pool = this.filtered().filter(i => DATA[i][1] !== \"—\");\n    const order = pool.slice().sort(() => Math.random() - 0.5).slice(0, Math.min(10, pool.length));\n    this.setState({ selIdx: null, quiz: { order: order, i: 0, score: 0, picked: null, total: order.length } }, () => {\n      setTimeout(() => this.playQuiz(), 380);\n    });\n  }\n  playQuiz() {\n    const q = this.state.quiz;\n    if (!q || q.i >= q.order.length) return;\n    const row = DATA[q.order[q.i]];\n    this.speak(this.letterAudioText(row), \"letter\", this.letterKey(row));\n  }\n  pickQuiz(idx) {\n    const q = this.state.quiz;\n    if (!q || q.picked != null) return;\n    const correct = q.order[q.i];\n    const ok = idx === correct;\n    this.setState({ quiz: Object.assign({}, q, { picked: idx, score: q.score + (ok ? 1 : 0) }) });\n    if (ok && this.state.learned.indexOf(idx) < 0) {\n      const s = this.state.learned.concat([idx]);\n      this.setState({ learned: s }, () => this.save());\n    }\n    setTimeout(() => {\n      const cur = this.state.quiz;\n      if (!cur) return;\n      this.setState({ quiz: Object.assign({}, cur, { i: cur.i + 1, picked: null }) }, () => {\n        if (this.state.quiz && this.state.quiz.i < this.state.quiz.order.length) this.playQuiz();\n      });\n    }, ok ? 700 : 1000);\n  }\n  quizOptions() {\n    const q = this.state.quiz;\n    const correct = q.order[q.i];\n    const seed = correct * 7 + q.i * 13;\n    const others = [];\n    let k = 0;\n    while (others.length < 3 && k < 400) {\n      const cand = (seed + k * 5 + 3) % DATA.length;\n      if (cand !== correct && others.indexOf(cand) < 0 && DATA[cand][1] !== \"—\") others.push(cand);\n      k++;\n    }\n    const all = others.concat([correct]);\n    all.sort((a, b) => ((a * 31 + seed) % 17) - ((b * 31 + seed) % 17));\n    return all;\n  }\n\n  decorate(i, t) {\n    const row = DATA[i];\n    const learned = this.state.learned.indexOf(i) >= 0;\n    const kz = row[3] === 1;\n    return {\n      i: i, pair: row[0], upper: row[0][0], ipa: row[1],\n      dot: kz ? \"#C97C24\" : row[2] === \"v\" ? ACCENT : row[2] === \"r\" ? \"#C9C4BA\" : \"#B7C4C9\",\n      bg: learned ? \"#F1F7F8\" : \"#FFFFFF\",\n      border: learned ? \"#BFD9E0\" : \"#E9E5DD\",\n      checkOpacity: learned ? 1 : 0,\n      firstWord: row[6][0][0],\n      firstGloss: this.state.lang === \"ru\" ? row[6][0][3] : row[6][0][2],\n      open: () => this.setState({ selIdx: i })\n    };\n  }\n\n  renderVals() {\n    const lang = this.state.lang;\n    const t = STR[lang] || STR.en;\n    const list = this.filtered();\n    const tiles = list.map(i => this.decorate(i, t));\n    const all = DATA.map((r, i) => this.decorate(i, t));\n\n    const fKeys = [\"all\", \"v\", \"c\", \"k\", \"r\"];\n    const filters = fKeys.map((k, n) => {\n      const on = this.state.filter === k;\n      return {\n        label: t.filters[n],\n        bg: on ? \"#16181A\" : \"#FFFFFF\",\n        fg: on ? \"#FFFFFF\" : \"#3C4247\",\n        border: on ? \"#16181A\" : \"#E4E0D8\",\n        pick: () => this.setState({ filter: k })\n      };\n    });\n\n    const learnedCount = this.state.learned.length;\n    const pct = learnedCount / DATA.length;\n\n    let sel = null;\n    if (this.state.selIdx != null) {\n      const i = this.state.selIdx, row = DATA[i];\n      const learned = this.state.learned.indexOf(i) >= 0;\n      sel = {\n        pair: row[0], upper: row[0][0], ipa: row[1],\n        catLabel: row[3] === 1 ? t.cats.k : t.cats[row[2] === \"r\" ? \"r\" : row[2]],\n        hint: lang === \"ru\" ? row[5] : row[4],\n        position: (i + 1) + \" / 42\",\n        ex: row[6].map(e => {\n          const k = this.clipKey(e[0], \"word\");\n          const on = this.state.recKey === k;\n          return {\n            w: e[0], ipa: e[1], gloss: lang === \"ru\" ? e[3] : e[2],\n            play: () => this.speak(e[0], \"word\"),\n            upload: () => this.pickFile(k),\n            rec: () => this.toggleRec(k),\n            del: () => this.delClip(k),\n            recBg: on ? \"#8E332A\" : \"#FFFFFF\",\n            recFg: on ? \"#FFFFFF\" : \"#5C6266\",\n            recBorder: on ? \"#8E332A\" : \"#E4E0D8\",\n            delShow: this.clips[k] ? \"inline-flex\" : \"none\",\n            ownShow: (this.clips[k] || (this.pack && this.pack[k])) ? \"inline-flex\" : \"none\"\n          };\n        }),\n        play: () => this.speak(this.letterAudioText(row), \"letter\", lk),\n        toggleLearned: () => this.toggleLearned(i),\n        learnLabel: learned ? t.learnedBtn : t.markLearned,\n        learnBg: learned ? \"#EAF2F4\" : \"#FFFFFF\",\n        learnFg: learned ? \"#0A4E64\" : \"#3C4247\",\n        learnBorder: learned ? \"#BFD9E0\" : \"#E4E0D8\"\n      };\n      const lk = this.letterKey(row);\n      sel.hasClip = !!(this.clips[lk] || (this.pack && this.pack[lk]));\n      sel.delShow = this.clips[lk] ? \"inline-flex\" : \"none\";\n      sel.upload = () => this.pickFile(lk);\n      sel.rec = () => this.toggleRec(lk);\n      sel.del = () => this.delClip(lk);\n      sel.recOn = this.state.recKey === lk;\n      sel.recLabel = sel.recOn ? t.recording : t.record;\n      sel.recBg = sel.recOn ? \"#8E332A\" : \"#FFFFFF\";\n      sel.recFg = sel.recOn ? \"#FFFFFF\" : \"#3C4247\";\n      sel.recBorder = sel.recOn ? \"#8E332A\" : \"#E4E0D8\";\n      sel.ownShow = sel.hasClip ? \"inline-flex\" : \"none\";\n      if (this.audioSrc === \"clip\") {\n        sel.audioNote = t.audioClip; sel.audioTone = \"#0A4E64\"; sel.audioBg = \"#EAF2F4\"; sel.audioShow = \"block\";\n      } else if (this.audioSrc === \"file\") {\n        sel.audioNote = t.audioFile; sel.audioTone = \"#0A4E64\"; sel.audioBg = \"#EAF2F4\"; sel.audioShow = \"block\";\n      } else if (this.audioSrc === \"missing\") {\n        sel.audioNote = t.audioMissing; sel.audioTone = \"#8A5A12\"; sel.audioBg = \"#FBF3E4\"; sel.audioShow = \"block\";\n      } else {\n        sel.audioNote = \"\"; sel.audioTone = \"#8A5A12\"; sel.audioBg = \"#FBF3E4\"; sel.audioShow = \"none\";\n      }\n    }\n\n    let quiz = null;\n    const q = this.state.quiz;\n    if (q) {\n      if (q.i >= q.order.length) {\n        const pctQ = q.score / Math.max(1, q.total);\n        quiz = {\n          active: false, done: true, counter: \"\",\n          scoreLabel: q.score + \" / \" + q.total,\n          verdict: pctQ >= 0.8 ? t.verdictHi : pctQ >= 0.5 ? t.verdictMid : t.verdictLo\n        };\n      } else {\n        const correct = q.order[q.i];\n        const opts = this.quizOptions().map(idx => {\n          const isCorrect = idx === correct, picked = q.picked === idx;\n          let bg = \"#FFFFFF\", border = \"#E9E5DD\", fg = \"#16181A\", anim = \"none\";\n          if (q.picked != null) {\n            if (isCorrect) { bg = \"#E8F5EE\"; border = \"#7FBF9B\"; fg = \"#14653C\"; anim = \"kzPop .35s ease both\"; }\n            else if (picked) { bg = \"#FBECEA\"; border = \"#E0A79F\"; fg = \"#8E332A\"; anim = \"kzShake .4s ease both\"; }\n          }\n          return { pair: DATA[idx][0], bg: bg, border: border, fg: fg, anim: anim, pick: () => this.pickQuiz(idx) };\n        });\n        const silent = this.audioSrc === \"missing\";\n        quiz = {\n          active: true, done: false,\n          counter: (q.i + 1) + \" / \" + q.total + \" · \" + q.score + (lang === \"ru\" ? \" верно\" : \" correct\"),\n          ipa: DATA[correct][1],\n          options: opts,\n          prompt: silent ? t.quizPromptIpa : t.quizPrompt,\n          note: silent ? t.audioMissing : \"\",\n          noteShow: silent ? \"block\" : \"none\",\n          playOpacity: silent ? \".45\" : \"1\",\n          replay: () => this.playQuiz()\n        };\n      }\n    }\n\n    return {\n      t: t, all: all, tiles: tiles, filters: filters, sel: sel, quiz: quiz,\n      canvasRef: this.canvasRef,\n      learnedLabel: learnedCount + \" / 42\",\n      progressOffset: (100.5 * (1 - pct)).toFixed(1),\n      enBg: lang === \"en\" ? \"#16181A\" : \"transparent\",\n      enFg: lang === \"en\" ? \"#FFFFFF\" : \"#7A8085\",\n      ruBg: lang === \"ru\" ? \"#16181A\" : \"transparent\",\n      ruFg: lang === \"ru\" ? \"#FFFFFF\" : \"#7A8085\",\n      setEn: () => { this.setState({ lang: \"en\" }); try { localStorage.setItem(KEY_LANG, \"en\"); } catch (e) {} },\n      setRu: () => { this.setState({ lang: \"ru\" }); try { localStorage.setItem(KEY_LANG, \"ru\"); } catch (e) {} },\n      close: () => this.setState({ selIdx: null }),\n      prev: () => this.step(-1),\n      next: () => this.step(1),\n      startQuiz: () => this.startQuiz(),\n      closeQuiz: () => this.setState({ quiz: null }),\n      doPrint: () => window.print(),\n      fileRef: this.fileRef,\n      packRef: this.packRef,\n      onFile: (e) => this.onFile(e),\n      importPack: (e) => this.importPack(e),\n      openPack: () => this.setState({ packOpen: true, packMsg: \"\" }),\n      pack: this.state.packOpen ? {\n        count: Object.keys(this.clips).length,\n        countLabel: t.packCount.replace(\"%N\", String(Object.keys(this.clips).length)),\n        emptyShow: Object.keys(this.clips).length ? \"none\" : \"block\",\n        msg: this.state.packMsg ? (t[\"pack\" + this.state.packMsg.charAt(0).toUpperCase() + this.state.packMsg.slice(1)] || \"\") : \"\",\n        msgShow: this.state.packMsg ? \"block\" : \"none\",\n        msgTone: (this.state.packMsg === \"err\" || this.state.packMsg === \"bakeErr\") ? \"#8E332A\" : \"#0A4E64\",\n        msgBg: (this.state.packMsg === \"err\" || this.state.packMsg === \"bakeErr\") ? \"#FBECEA\" : \"#EAF2F4\",\n        guide: t.guide.map((s, n) => ({ n: (n + 1) + \".\", text: s })),\n        guideShow: this.state.guideOpen ? \"block\" : \"none\",\n        guideLabel: this.state.guideOpen ? t.guideHide : t.guideOpen,\n        toggleGuide: () => this.setState({ guideOpen: !this.state.guideOpen }),\n        bake: () => this.bake(),\n        exportPack: () => this.exportPack(),\n        importClick: () => { if (this.packRef.current) this.packRef.current.click(); },\n        close: () => this.setState({ packOpen: false, packMsg: \"\" })\n      } : null,\n      micErrShow: this.state.recErr ? \"block\" : \"none\",\n      clearTrace: () => this.clearTrace(),\n      traceDown: (e) => {\n        const ctx = this.ctx(); if (!ctx) return;\n        e.currentTarget.setPointerCapture && e.currentTarget.setPointerCapture(e.pointerId);\n        this.drawing = true; this.lastPt = this.pt(e);\n      },\n      traceMove: (e) => {\n        if (!this.drawing) return;\n        const ctx = this.ctx(); if (!ctx) return;\n        const p = this.pt(e);\n        ctx.strokeStyle = ACCENT; ctx.lineWidth = 9; ctx.lineCap = \"round\"; ctx.lineJoin = \"round\";\n        ctx.beginPath(); ctx.moveTo(this.lastPt.x, this.lastPt.y); ctx.lineTo(p.x, p.y); ctx.stroke();\n        this.lastPt = p;\n      },\n      traceUp: () => { this.drawing = false; this.lastPt = null; }\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
